

# Session signing secret — REQUIRED at app startup (main.py refuses to boot
# without it). Generate a real random value for any non-toy run, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_this_to_a_random_secret
MESH_API_KEY=your_mesh_key_here # get this from Mesh dashboard, starts with rsk_
MESH_MODEL=openai/gpt-4o
MESH_EMBED_MODEL=openai/text-embedding-3-small
MESH_BASE_URL=https://api.meshapi.ai/v1

# Local HuggingFace / Transformers settings
HF_HUB_OFFLINE=1

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=smartreco

# APScheduler Proactive Delivery Configuration
DIGEST_SCHEDULE_HOUR=16
DIGEST_SCHEDULE_MINUTE=0

# SMTP Email Credentials (Optional Email Digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
DIGEST_FROM_EMAIL=digest@smartreco.ai

# Telegram Bot Credentials (Optional Telegram Digest)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
